[Unit]
Description=InsertPlay — SD game card auto-launcher
After=network.target

[Service]
Type=simple
ExecStart=/opt/insertplay/InsertPlay.Service
Restart=on-failure
RestartSec=5
# Run as the local user so SD cards mounted under /run/media/$USER are accessible.
# Change to a dedicated service account if preferred.
User=%i

[Install]
WantedBy=default.target
