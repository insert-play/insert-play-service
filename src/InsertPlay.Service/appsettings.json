{
  "InsertPlay": {
    "DetectionMethod": "Auto",
    "DefaultStopCombination": [ "Back", "Start" ],
    "ControllerPollIntervalMs": 50,
    "LinuxMediaPaths": [ "/media", "/run/media/$USER" ],
    "LogLevel": "Information"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
