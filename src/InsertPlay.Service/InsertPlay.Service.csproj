<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- On Windows both TFMs are built; on Linux only net8.0 is available. -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net8.0-windows;net8.0</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-InsertPlay.Service-c9f718c0-3a29-48ea-a7a8-32c4b3aa1418</UserSecretsId>
  </PropertyGroup>

  <!-- Windows: WinForms tray application (no console window) -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- Linux: standard console executable -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Restore the global using that Microsoft.NET.Sdk.Worker provided automatically -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <!-- Windows-only source files are excluded from the Linux build -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="Windows\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <!-- Platform-specific project references -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <ProjectReference Include="..\InsertPlay.Core\InsertPlay.Core.csproj" />
    <ProjectReference Include="..\InsertPlay.Windows\InsertPlay.Windows.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <ProjectReference Include="..\InsertPlay.Core\InsertPlay.Core.csproj" />
    <ProjectReference Include="..\InsertPlay.Linux\InsertPlay.Linux.csproj" />
  </ItemGroup>

  <!-- Application icon (Windows only) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <EmbeddedResource Include="Resources\icon.png" />
  </ItemGroup>

  <!-- SDL2 native runtime — Windows x64.
       Run tools/get-sdl2-native.ps1 once to populate this file before building. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Content Include="native\win-x64\SDL2.dll"
             Condition="Exists('native\win-x64\SDL2.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>SDL2.dll</TargetPath>
    </Content>
  </ItemGroup>

  <!-- Warn at build time when SDL2.dll is missing on Windows. -->
  <Target Name="CheckSdl2Native"
          BeforeTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Warning Condition="!Exists('native\win-x64\SDL2.dll')"
             Text="SDL2.dll not found at src/InsertPlay.Service/native/win-x64/SDL2.dll. Run tools/get-sdl2-native.ps1 before running the service on Windows." />
  </Target>

</Project>
